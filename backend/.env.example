# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (use a dedicated app user with least privilege, not an admin account)
MONGO_URL=mongodb://localhost:27017/aircnc

# Port the API listens on
PORT=3333

# Public base URL used to build absolute links to uploaded files (must match how clients reach this API)
APP_URL=http://localhost:3333

# Comma-separated list of origins allowed to call the API (no wildcard in production)
CORS_ORIGIN=http://localhost:3000
